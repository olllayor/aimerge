{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "ts",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node", "vitest/globals"],
		"declaration": true
	},
	"include": ["ts/src/**/*.ts", "ts/tests/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
